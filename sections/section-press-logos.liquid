<style>

  @media screen and (max-width: 767px) {
  .logos__slider__outer {
    position: relative !important;
    overflow: visible !important;
  }

  .custom-logo-arrow {
    position: absolute !important;
    top: 50% !important;
    transform: translateY(-50%) !important;
    z-index: 9999 !important;
    width: 44px;
    height: 44px;
    display: flex !important;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 0;
    padding: 0;
    cursor: pointer;
  }

  .custom-logo-arrow::before {
    content: "";
    width: 14px;
    height: 14px;
    display: block;
    border-top: 2px solid #222;
    border-left: 2px solid #222;
  }

  .custom-logo-arrow--prev {
    left: 14px !important;
    right: auto !important;
  }

  .custom-logo-arrow--prev::before {
    transform: rotate(-45deg);
  }

  .custom-logo-arrow--next {
    right: 14px !important;
    left: auto !important;
  }

  .custom-logo-arrow--next::before {
    transform: rotate(135deg);
  }
}

</style>



<script>
document.addEventListener('click', function(e) {
  const nextBtn = e.target.closest('.custom-logo-arrow--next');
  const prevBtn = e.target.closest('.custom-logo-arrow--prev');

  if (!nextBtn && !prevBtn) return;

  const wrapper = e.target.closest('.logos__slider__outer');
  if (!wrapper) return;

  const slider = wrapper.querySelector('[data-slider-logos]');
  if (!slider) return;

  const firstItem = slider.querySelector('.logos__slide');
  if (!firstItem) return;

  const scrollAmount = firstItem.offsetWidth;

  slider.scrollBy({
    left: nextBtn ? scrollAmount : -scrollAmount,
    behavior: 'smooth'
  });
});
</script>





<!-- /sections/section-logo-list.liquid -->

{%- liquid
  assign logo_opacity_default = section.settings.logo_opacity | default: 100
  assign logo_opacity = logo_opacity_default | times: 0.01
  assign show_slider_text = false
  assign bg_color = section.settings.bg_color
  assign text_color = section.settings.color
  assign enable_slider = section.settings.enable_heading_slider
  assign animation_anchor = '#Logos--' | append: section.id
  assign animation_order = 1
-%}

{%- style -%}
  #Logos--{{ section.id }} {
    --PT: {{ section.settings.padding_top }}px;
    --PB: {{ section.settings.padding_bottom }}px;

    {%- if section.settings.enable_heading_slider -%}
      --logo-opacity: {{ logo_opacity }};
    {%- endif -%}

    {%- unless text_color == 'rgba(0,0,0,0)' or text_color == blank -%}
      --text: {{ text_color }};
    {%- endunless -%}

    {%- unless bg_color == 'rgba(0,0,0,0)' or bg_color == blank -%}
      --bg: {{ bg_color }};
    {%- endunless -%}
  }

  {%- if request.visual_preview_mode -%}
    .logos__slide__text {
      opacity: 1;
      transform: translateY(0%);
    }
  {%- endif -%}
{%- endstyle -%}

{%- if section.settings.title != blank -%}
  {%- capture heading -%}
    <h2 class="logos__title subheading subheading-size-1"
      data-aos="hero"
      data-aos-anchor="{{ animation_anchor }}"
      data-aos-order="{{ animation_order }}"
    >
      {{ section.settings.title }}
    </h2>
  {%- endcapture -%}
{%- endif -%}

{%- for block in section.blocks -%}
  {%- capture slides -%}
    {{ slides }}
    {%- liquid
      assign logo = block.settings.logo
      assign logo_width = block.settings.logo_width
      assign sizes = logo_width | append: 'px'
      assign width = logo_width | times: 2
      assign width_retina = logo_width | times: 2
      assign widths = '100, 120, 140, 160, 180, 200, 240, 280, 320, 360, ' | append: logo_width | append: ', ' | append: width_retina
      assign link = block.settings.link

      if block.settings.heading != blank and section.settings.enable_heading_slider
        assign show_slider_text = true
      endif
    -%}

    <div class="logos__slide{% if forloop.first and enable_slider %} is-selected{% endif %}"
      data-slide="{{ block.id }}"
      data-slide-index="{{ forloop.index0 }}"
      {{ block.shopify_attributes }}>

    {%- if enable_slider -%}
      <button
        class="logos__slide__link"
        type="button"
        aria-label="{{ 'general.accessibility.scroll_to_logo' | t }}">
    {%- endif -%}

      {%- if link != blank and enable_slider == false -%}
        <a class="logos__slide__link" href="{{ link }}" aria-label="{{ logo.alt | strip_html | escape }}">
      {%- endif -%}

      <div class="logos__logo">
        {%- if logo != blank -%}
          <div class="logos__img" style="width: {{ logo_width }}px; height: {{ logo_width | divided_by: logo.aspect_ratio }}px;">
            {%- render 'image' image: logo, sizes: sizes, width: width, widths: widths, show_backfill: false -%}
          </div>
        {%- else -%}
          <div class="logos__img svg-placeholder" style="width: {{ logo_width }}px; height: {{ logo_width }}px;">
            {{ 'logo' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>

      {%- if link != blank and enable_slider == false -%}
        </a>
      {%- endif -%}

      {%- if enable_slider -%}
        </button>
      {%- endif -%}
    </div>
  {%- endcapture -%}

  {%- capture contents -%}
    {{ contents }}

    {%- assign text = block.settings.heading -%}

    <div class="logos__slide logos__slide--{{ block.id }}"
      data-slide-index="{{ forloop.index0 }}"
      data-slide="{{ block.id }}"
      {{ block.shopify_attributes }}>
      {%- if text != blank -%}
        {%- assign font_size_class = block.settings.heading_size | prepend: 'body-size-' -%}
        <div class="logos__slide__text {{ font_size_class }} {{ section.settings.text_style }}">{{ text }}</div>
      {%- endif -%}
    </div>
  {%- endcapture -%}
{%- endfor -%}

<div id="Logos--{{ section.id }}"
  class="logos section-padding{% if enable_slider %} logos-press{% endif %}"
  data-section-id="{{ section.id }}"
  data-section-type="logos">
  <div class="logos__wrapper">
    {{ heading }}

    {%- if section.blocks.size > 0 -%}
      {%- assign animation_order = animation_order | plus: 1 -%}
      <div class="logos__slider__outer"
        data-aos="hero"
        data-aos-anchor="{{ animation_anchor }}"
        data-aos-order="{{ animation_order }}"
      >

        <button class="custom-logo-arrow custom-logo-arrow--prev" type="button"></button>

        <div class="logos__slider" data-slider-logos data-block-scroll>
          {{ slides }}  
        </div>
        <button class="custom-logo-arrow custom-logo-arrow--next" type="button"></button>
      </div>
    {%- else -%}
      {%- render 'no-blocks' -%}
    {%- endif -%}

    {%- if show_slider_text -%}
      {%- assign animation_order = animation_order | plus: 1 -%}

      <div class="logos__slider-text wrapper" id="logos__slider-text--{{ section.id }}"
        data-slider-text
        data-aos="hero"
        data-aos-anchor="{{ animation_anchor }}"
        data-aos-order="{{ animation_order }}"
      >
        {{ contents }}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Press logos",
  "max_blocks": 25,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Subheading",
      "default": "As seen in"
    },
    {
      "type": "header",
      "content": "Quote"
    },
    {
      "type": "checkbox",
      "id": "enable_heading_slider",
      "label": "Enable heading slider",
      "default": true
    },
    {
      "type": "select",
      "id": "text_style",
      "label": "Text style",
      "default": "font-body",
      "options": [
        {"value": "font-heading", "label": "Heading"},
        {"value": "font-body", "label": "Body"}
      ]
    },
    {
      "type": "range",
      "id": "logo_opacity",
      "label": "Inactive logo opacity",
      "unit": "%",
      "min": 5,
      "max": 100,
      "step": 5,
      "default":60
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "color",
      "label": "Text"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding top",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding bottom",
      "default": 50
    }
  ],
  "blocks": [
    {
      "type": "logo-item",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "range",
          "id": "logo_width",
          "label": "Width",
          "unit": "px",
          "min": 100,
          "max": 180,
          "step": 10,
          "default": 100
        },
        {
          "type": "header",
          "content": "Link",
          "info": "Applies if 'enable heading slider' is disabled"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "header",
          "content": "Quote",
          "info": "Applies if 'enable heading slider' is enabled"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Include a brief quote from a brand that loves your products"
        },
        {
          "type":  "range",
          "id":    "heading_size",
          "label": "Size",
          "min": 1,
          "max": 15,
          "step": 1,
          "default": 6
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Press logos",
      "category": "Image",
      "blocks": [
        {
          "type": "logo-item"
        },
        {
          "type": "logo-item"
        },
        {
          "type": "logo-item"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "aside", "footer"]
  }
}
{% endschema %}

<section class="linen-info-section section-{{ section.id }}">
  <div class="linen-info-wrapper">
    {% if section.settings.heading != blank %}
      <h2 class="linen-info-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="linen-info-slider-wrap">
      <button class="linen-info-slider-btn linen-info-prev" type="button" aria-label="Previous slide"></button>
      <button class="linen-info-slider-btn linen-info-next" type="button" aria-label="Next slide"></button>

      <div class="linen-info-grid">
        {% for block in section.blocks %}
          <div class="linen-info-card" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              <div class="linen-info-image">
                <img
                  src="{{ block.settings.image | image_url: width: 900 }}"
                  alt="{{ block.settings.title | escape }}"
                  loading="lazy"
                >
              </div>
            {% endif %}

            {% if block.settings.title != blank %}
              <h3>{{ block.settings.title }}</h3>
            {% endif %}

            {% if block.settings.text != blank %}
              <p>{{ block.settings.text }}</p>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<style>
  .section-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.bg_color }};
  }

  .section-{{ section.id }} .linen-info-wrapper {
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 15px;
  }

  .section-{{ section.id }} .linen-info-heading {
    margin-bottom: 35px;
    font-size: {{ section.settings.heading_size }}px;
    color: {{ section.settings.text_color }};
  }

  .section-{{ section.id }} .linen-info-slider-wrap {
    position: relative;
  }

  .section-{{ section.id }} .linen-info-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: {{ section.settings.gap }}px;
  }

  .section-{{ section.id }} .linen-info-card {
    color: {{ section.settings.text_color }};
  }

  .section-{{ section.id }} .linen-info-image {
    width: 100%;
    aspect-ratio: {{ section.settings.image_ratio }};
    overflow: hidden;
    background: #f5f5f5;
  }

  .section-{{ section.id }} .linen-info-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .section-{{ section.id }} .linen-info-card h3 {
    margin: 18px 0 10px;
    font-size: {{ section.settings.title_size }}px;
    font-weight: 400;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .section-{{ section.id }} .linen-info-card p {
    margin: 0;
    font-size: {{ section.settings.text_size }}px;
    line-height: 1.4;
    max-width: 95%;
  }

  .section-{{ section.id }} .linen-info-slider-btn {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .section-{{ section.id }} .linen-info-wrapper {
      padding: 0 10px;
    }

    .section-{{ section.id }} .linen-info-grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 0;
      padding-bottom: 10px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .section-{{ section.id }} .linen-info-grid::-webkit-scrollbar {
      display: none;
    }

    .section-{{ section.id }} .linen-info-card {
      min-width: 100%;
      width: 100%;
      scroll-snap-align: start;
      flex-shrink: 0;
    }

    .section-{{ section.id }} .linen-info-image {
      aspect-ratio: 4 / 5;
    }

    .section-{{ section.id }} .linen-info-card h3 {
      margin: 14px 0 8px;
      font-size: 13px;
    }

    .section-{{ section.id }} .linen-info-card p {
      font-size: 12px;
      line-height: 1.35;
      max-width: 95%;
    }

    .section-{{ section.id }} .linen-info-slider-btn {
      display: flex;
      position: absolute;
      top: 40%;
      transform: translateY(-50%);
      width: 32px;
      height: 32px;
      border-radius: 50%;
      border: none;
      align-items: center;
      justify-content: center;
      z-index: 5;
      cursor: pointer;
      padding: 0;
    }

    .section-{{ section.id }} .linen-info-slider-btn::before {
      content: "";
      width: 10px;
      height: 10px;
      border-top: 2px solid #000;
      border-right: 2px solid #000;
      display: block;
    }

    .section-{{ section.id }} .linen-info-prev {
      left: 8px;
    }

    .section-{{ section.id }} .linen-info-next {
      right: 8px;
    }

    .section-{{ section.id }} .linen-info-prev::before {
      transform: rotate(-135deg);
      margin-left: 4px;
    }

    .section-{{ section.id }} .linen-info-next::before {
      transform: rotate(45deg);
      margin-right: 4px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const section = document.querySelector('.section-{{ section.id }}');
    if (!section) return;

    const slider = section.querySelector('.linen-info-grid');
    const prev = section.querySelector('.linen-info-prev');
    const next = section.querySelector('.linen-info-next');

    if (!slider || !prev || !next) return;

    next.addEventListener('click', function () {
      slider.scrollBy({
        left: slider.clientWidth,
        behavior: 'smooth'
      });
    });

    prev.addEventListener('click', function () {
      slider.scrollBy({
        left: -slider.clientWidth,
        behavior: 'smooth'
      });
    });
  });
</script>

{% schema %}
{
  "name": "Linen Info Cards",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1f2937"
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Container width",
      "min": 900,
      "max": 2000,
      "step": 50,
      "default": 1600
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "3 / 2", "label": "Landscape" },
        { "value": "16 / 9", "label": "Wide" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Desktop gap",
      "min": 2,
      "max": 80,
      "step": 1,
      "default": 44
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading font size",
      "min": 18,
      "max": 60,
      "step": 1,
      "default": 32
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title font size",
      "min": 12,
      "max": 30,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Description font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 15
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 5,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 5,
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Info card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Normandy, France"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Our linen comes from Normandy, France, in flax fields on cliffs overlooking the British Channel."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Linen Info Cards",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
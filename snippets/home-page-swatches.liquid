{%- comment -%} Home Page Swatches Snippet - Unique Colors {%- endcomment -%}

<div class="product-item__swatches__holder">
  {%- assign added_colors = '' | split: ',' -%}

  {%- for variant in product.variants -%}
    {%- assign color_index = 0 -%}
    {%- for option in product.options_with_values -%}
      {%- assign option_name = option.name | downcase -%}
      {%- if option_name == 'color' or option_name == 'colour' -%}
        {%- assign color_index = forloop.index0 -%}
      {%- endif -%}
    {%- endfor -%}

    {%- assign variant_color = variant.options[color_index] | default: 'Default' -%}

    {%- unless added_colors contains variant_color -%}
      <div class="swatch__button swatch-{{ variant_color | handle }}"
           style="background-color: {{ variant_color }};"
           data-sibling-image="{{ variant.featured_media.preview_image.src | default: product.featured_media.preview_image.src }}"
           data-tooltip="{{ variant_color }}">
      </div>
      {%- assign added_colors = added_colors | push: variant_color -%}
    {%- endunless -%}
  {%- endfor -%}
</div>

<script>
document.addEventListener('click', function(e){
  const swatch = e.target.closest('.swatch__button');
  if(!swatch) return;

  const productCard = swatch.closest('.product-item');
  if(!productCard) return;

  const mainImg = productCard.querySelector('[data-product-image] img');

  if(mainImg && swatch.dataset.siblingImage){
    mainImg.src = swatch.dataset.siblingImage;
  }

  // Highlight the active swatch
  const holder = swatch.closest('.product-item__swatches__holder');
  if(holder){
    holder.querySelectorAll('.swatch__button').forEach(btn => btn.classList.remove('active'));
    swatch.classList.add('active');
  }
});
</script>

<style>
.product-item__swatches__holder {
  display: flex;
  margin-top: 6px;
  flex-wrap: wrap;
}
.swatch__button {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  border: 1px solid #ddd;
  margin-right: 6px;
  margin-bottom: 4px;
  cursor: pointer;
}
.swatch__button.active {
  border: 2px solid #000;
}
</style>
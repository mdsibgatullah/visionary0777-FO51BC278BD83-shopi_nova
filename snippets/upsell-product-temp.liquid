{%- liquid
  assign upsell_modifier = upsell_modifier | default: ''
  assign upsell_button_text = 'products.general.upsell_add_to_cart' | t
  assign upsell_quick_add_hide = upsell_quick_add_hide | default: false
  assign upsell_description = upsell_description | default: ''

  if upsell_product == blank
    assign show_upsell = false
    assign upsell_error = true
  endif

  if request.design_mode or upsell_product != blank
    assign show_upsell = true
  endif

  assign upsell_variant = upsell_product.selected_or_first_available_variant
  assign upsell_variant_image = upsell_variant.featured_media | default: upsell_product.featured_media.preview_image

  if settings.currency_code_enable
    assign upsell_variant_price = upsell_variant.price | money_with_currency
    assign upsell_variant_compare_at_price = upsell_variant.compare_at_price | money_with_currency
  else
    assign upsell_variant_price = upsell_variant.price | money
    assign upsell_variant_compare_at_price = upsell_variant.compare_at_price | money
  endif

  assign unique = section.id | append: '-' | append: upsell_product.id
  assign product_form_id = 'ProductFormUpsell--' | append: unique

  assign is_product_list = is_product_list | default: false
  assign show_avaialable_upsell_only = show_avaialable_upsell_only | default: false

  if show_avaialable_upsell_only and upsell_variant.available == false
    assign show_upsell = false
  endif

  if show_upsell and upsell_product.variants.size == 1 and upsell_variant.available != true
    assign upsell_quick_add_hide = true
  endif

  assign product_title = 'products.general.upsell_error_title' | t
  assign product_info = 'products.general.upsell_error_info' | t

  if onboarding
    assign show_upsell = true
    assign upsell_error = true
    assign product_title = 'products.general.choose_product' | t
    assign product_info = 'products.general.product_info' | t
  endif
-%}

{%- if show_upsell -%}
  <quick-add-product>
    <div class="product-upsell__holder{% if upsell_error %} product-upsell__holder--onboarding{% endif %}{% if is_cart %} product-upsell__holder--cart{% elsif upsell_quick_add_hide != true %} product-upsell__holder--button{% endif %}" data-quick-add-holder="{{ upsell_product.id }}">
      <div data-cart-errors-container class="product-upsell__errors"></div>

      <div class="product-upsell{% if upsell_modifier != '' %} {{ upsell_modifier }}{% endif %}">
        <div class="product-upsell__image">
          {%- if upsell_error -%}
            <div class="product-upsell__image__thumb svg-placeholder" role="img">
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- else -%}
            <a href="{{ upsell_product.url }}" class="product-upsell__image__link" aria-label="{{ upsell_product.title | strip_html | escape }}">
              <div class="product-upsell__image__thumb">
                {%- render 'image' image: upsell_variant_image, widths: '120, 180, 240, 300, 360', width: '240', sizes: '120px', cover: true -%}
              </div>
            </a>
          {%- endif -%}
        </div>

        <div class="product-upsell__content">
          
          {%- if upsell_error -%}
            <p class="product-upsell__title h3">{{ product_title }}</p>
            <p class="product-upsell__variant-title h4">{{ product_info }}</p>

            {%- if onboarding and upsell_quick_add_hide == false -%}
              <div class="product-upsell__actions">
                <div class="btn__outer">
                  <button class="product-upsell__btn"
                    type="button"
                  >
                    <span class="btn__plus"></span>
                    <span class="btn__text">{{ upsell_button_text }}</span>
                  </button>
                </div>
              </div>
            {%- endif -%}
          {%- else -%}
            
            <a href="{{ upsell_product.url }}" class="product-upsell__link">
              <div class="first-row">
              <p class="product-upsell__title h3">{{ upsell_product.title | strip_html }}</p>

 {%- if upsell_product.variants.size == 1 and upsell_variant.title != 'Default Title' -%}
                <p class="product-upsell__variant-title h4">{{ upsell_variant.title | replace: '/', '<span>&nbsp;</span>' }}</p>
              {%- endif -%}

              <p class="product-upsell__price{% if upsell_variant.compare_at_price > upsell_variant.price %} sale{% endif %}">
                <span class="new-price">
                  {%- if upsell_variant.price == 0 -%}
                    {{ 'general.money.free' | t }}
                  {%- else -%}
                    {{ upsell_variant_price }}
                  {%- endif -%}
                </span>

                {%- if upsell_variant.compare_at_price > upsell_variant.price -%}
                  <span class="old-price">{{ upsell_variant_compare_at_price }}</span>
                {%- endif -%}

                {%- if upsell_variant.unit_price -%}
                  {%- capture unit_price_separator -%}
                    <span aria-hidden="true">/</span>
                    <span class="visually-hidden">{{ 'general.accessibility.unit_price_separator' | t }}&nbsp;</span>
                  {%- endcapture -%}

                  {%- capture unit_price_base_unit -%}
                    {% if upsell_variant.unit_price_measurement.reference_value != 1 %}
                      {{ upsell_variant.unit_price_measurement.reference_value }}
                    {% endif %}
                    {{ upsell_variant.unit_price_measurement.reference_unit }}
                  {%- endcapture -%}

                  <br>

                  <span class="visually-hidden visually-hidden--inline">{{ 'products.product.unit_price_label' | t }}</span>

                  <span class="unit">
                    {{ upsell_variant.unit_price | money }}
                    {{ unit_price_separator }}
                    {{ unit_price_base_unit }}
                  </span>
                {% endif %}
              </p>
            </div>
            <div class="second-row">
              <span class="product-item__variant-collection">
                {% if upsell_product.variants.size > 0 %}
                  {% assign color_option_value = "" %}
                  {% for option in upsell_product.options_with_values %}
                    {% if option.name == "color" or option.name == "Color" %}
                      {% assign color_option_value = upsell_product.variants.first.options[forloop.index0] %}
                      {% break %}
                    {% endif %}
                  {% endfor %}
                  {% if color_option_value != "" %}
                    <span class="product-item__variant">{{ color_option_value }}</span>
                    {%- for collection in upsell_product.collections -%}
                      {%- if collection.title == "Organic Linen" -%}
                        <span class="separator">|</span>
                        <span class="product-item__collection">{{ collection.title }}</span>
                      {%- endif -%}
                    {%- endfor -%} 
                  {% endif %}
                {% endif %}
              </span>
            </div>
             
            </a>

            <!-- Add to Cart Form -->
            <form action="/cart/add" method="post" id="ProductFormUpsell--template--{{ upsell_product.id }}" class="product-form">
              <!-- Variant selector dropdown with unique IDs -->
              <select name="id" id="size-selector-{{ upsell_product.id }}" class="size-dropdown" form="ProductFormUpsell--template--{{ upsell_product.id }}">
                <option value="" disabled selected>Select a Size</option>
                {% assign size_option_index = upsell_product.options_with_values | where: 'name', 'Size' | first %}
                {% if size_option_index %}
                  {% assign size_option_position = size_option_index.position | minus: 1 %}
                  {% for variant in upsell_product.variants %}
                    {% assign size_value = variant.options[size_option_position] %}
                    <option value="{{ variant.id }}" data-variant-id="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>
                      {{ size_value }}
                    </option>
                  {% endfor %}
                {% else %}
                  <option value="" disabled>No size options available</option>
                {% endif %}
              </select>

              <!-- Add to Cart button -->
              <button class="upsell-atc product__submit btn--primary" type="submit" id="add-to-cart-button-{{ upsell_product.id }}" >
                Add to cart
              </button>
            </form>
          {%- endif -%}
        </div>
      </div>

      {%- unless upsell_product.has_only_default_variant -%}
        {%- render 'product-quick-add-modal-template', product_id: upsell_product.id, unique: unique -%}
      {%- endunless -%}
    </div>
  </quick-add-product>
{%- endif -%}

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sizeSelector = document.getElementById('size-selector-{{ upsell_product.id }}');
    const addToCartButton = document.getElementById('add-to-cart-button-{{ upsell_product.id }}');

    if (!sizeSelector) {
      console.error('Size selector not found');
      return;
    }

    if (!addToCartButton) {
      console.error('Add to Cart button not found');
      return;
    }

    sizeSelector.addEventListener('change', function() {
      if (this.value) {
        addToCartButton.removeAttribute('disabled');
        console.log('Add to Cart button enabled with variant ID:', this.value);
      } else {
        addToCartButton.setAttribute('disabled', 'disabled');
        console.log('Add to Cart button remains disabled');
      }
    });
  });
</script>

<style>
.selector-wrapper {
    color: var(--COLOR-TEXT);
  width:100%;
    height:auto;
  border-radius: 0 !important;
}

.selector-wrapper-dropdown {
    position: relative;
    padding-top: 8px;
  border-radius: 0 !important;
}

.selector-wrapper-current-text {
    display: block;
    font-family: var(--FONT-STACK-BODY);
    font-size: var(--FONT-SIZE-BASE);
    line-height: var(--LINE-HEIGHT-NORMAL);
}
.size-dropdown { border-radius: 0 !important;width:100%;border: 1px solid black;}
  .size-dropdown option {  border-radius: 0 !important;}
  select>option {
     border-radius: 0px !important;
}
svg.absolute {
    position: absolute;
    right: 2px;
    pointer-events: none;
}

.radio__fieldset {
    display: block;
    padding: 10px;
}

.radio__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.radio__button {
    display: flex;
    align-items: center;
}

input[type="radio"] {
    display: none; /* Hide default radio input */
}

.radio__button label {
    display: flex;
    align-items: center;
    cursor: pointer;
    padding: 8px 12px;
    border: 1px solid var(--COLOR-BORDER);
    border-radius: 4px;
    background-color: var(--COLOR-BG);
    transition: background-color 0.3s, border-color 0.3s;
}

.radio__button label:hover {
    border-color: var(--COLOR-PRIMARY-HOVER);
    background-color: var(--COLOR-PRIMARY-FADE);
}

.radio__button input:checked + label {
    border-color: var(--COLOR-PRIMARY);
    background-color: var(--COLOR-PRIMARY);
    color: var(--COLOR-PRIMARY-OPPOSITE);
}

/* Add to Cart Button */
.upsell-atc {
    display: inline-block;
    margin-top: 0px;
    padding: 10px 20px;
    background-color: var(--BTN-PRIMARY-BG-COLOR);
    color: var(--BTN-PRIMARY-TEXT-COLOR);
    border: none;
    border-radius: 0px;
    text-transform: var(--BTN-UPPERCASE);
    letter-spacing: var(--BTN-LETTER-SPACING);
    font-size: var(--BTN-FONT-SIZE);
    cursor: pointer;
    transition: background-color 0.3s;
    width: 100%;
  height:auto;
}

.upsell-atc:hover {
    background-color: var(--BTN-PRIMARY-BG-COLOR-BRIGHTER);
}

.product-upsell__content {
  display: flex;
  flex-direction: column;
  gap: 10px; /* Optional: Adds spacing between rows */
 
    padding-right: 0 !important;
width: calc(100% - 200px) !important;
background-color: white;
}
.product-upsell__image {
    width: 200px;
}
.first-row {
  display: flex;
  justify-content: space-between; /* Title on the left, price on the right */
  align-items: center;
}

.product-upsell__title {
  margin: 0; /* Removes any default margins */
}

.product-upsell__price {
  margin: 0; /* Removes any default margins */
}

.second-row {
  text-align: left; /* Align variant collection to the left */
}

.product-form {
  margin-top: 10px; /* Adds spacing above the form */
}


  @media (max-width:767px){.product-upsell__content {
  display: flex;
  flex-direction: column;
  gap: 0px; /* Optional: Adds spacing between rows */
 
    padding-right: 0 !important;
    margin-right: 0 !important;
width: calc(100% - 200px) !important;
background-color: white !important;
}
.product-upsell__image {
    width: 120px;
}
          .product-upsell {
    display: flex; /* Use flexbox layout */
    flex-direction: row; /* Stack image and content vertically */
    width: 100%; /* Ensure it takes the full width */
    height: 100%; /* Ensure it takes the full height */
    box-sizing: border-box; /* Include padding and border in the element's total width and height */
}

.product-upsell__image {
    flex: 0 0 40%; /* Set image to take 40% of the height */
    width: 100%; /* Ensure full width */
    box-sizing: border-box; /* Include padding and border in the element's total width */
}

.product-upsell__content {
    flex: 0 0 60%; /* Set content to take 60% of the height */
    width: 100%; /* Ensure full width */
    padding-left: 20px; /* Add padding for better spacing */
    background: #fff; /* Optional: background color for content */
    box-sizing: border-box; /* Include padding and border in the element's total width */
}
      .radio__button input:checked + label {
    
    background-color: transparent;
        color:black;
   
} .size-dropdown {
        
    width: 100%;
    border: 1px solid black;
    text-transform: uppercase;
    font-style: normal;
    font-size: 11.16px;
}  .upsell-atc {
   
    font-size: 11.16px;
}
                          .product-form {
    margin-top: 0px;
                            
}}
</style>

          "settings": {
            "code": "<div class=\"personalization-wrapper\">\n  \n  <div id=\"personalization-summary\" class=\"pers-summary-box\" style=\"display: none;\">\n    <span class=\"summary-label\">Personalise: <strong id=\"summary-text-values\"></strong></span>\n    <div class=\"summary-actions\">\n      <button type=\"button\" id=\"edit-pers-btn\" class=\"link-btn\">Edit</button> | \n      <button type=\"button\" id=\"clear-pers-btn\" class=\"link-btn\">Clear</button>\n    </div>\n  </div>\n\n  <button type=\"button\" id=\"open-pers-modal\" class=\"btn-personalise\">PERSONALISE</button>\n</div>\n\n<div id=\"shopify-hidden-properties\">\n  <input type=\"hidden\" name=\"properties[_Personalized]\" id=\"prop-active\" value=\"No\">\n  <input type=\"hidden\" name=\"properties[Text]\" id=\"prop-text\" disabled>\n  <input type=\"hidden\" name=\"properties[Font]\" id=\"prop-font\" disabled>\n  <input type=\"hidden\" name=\"properties[Symbol]\" id=\"prop-symbol\" disabled>\n  <input type=\"hidden\" name=\"properties[Thread Color]\" id=\"prop-color\" disabled>\n  <input type=\"hidden\" name=\"properties[Position]\" id=\"prop-position\" disabled>\n</div>\n\n<div id=\"pers-modal\" class=\"pers-modal-overlay\">\n  <div class=\"pers-modal-content\">\n    <button type=\"button\" class=\"close-modal-btn\" id=\"close-pers-modal\">&times;</button>\n    \n    <h2>Personalise your style</h2>\n    <p class=\"pers-subtitle\">Whether as a gift for your loved ones or for yourself, we embroider the desired Initials onto your favorite styles.</p>\n    \n    <div class=\"pers-grid\">\n      <div class=\"pers-field-group\">\n        <label>CHARACTERS (<span id=\"char-count\">0</span>/3)</label>\n        <input type=\"text\" id=\"input-text\" maxlength=\"3\" placeholder=\"ASF\" autocomplete=\"off\">\n        <small class=\"field-help\">Letters, numbers and special characters.</small>\n      </div>\n\n      <div class=\"pers-field-group\">\n        <label>FONT</label>\n        <select id=\"input-font\">\n          <option value=\"BLOCK\">BLOCK</option>\n          <option value=\"SCRIPT\">SCRIPT</option>\n          <option value=\"MODERN\">MODERN</option>\n        </select>\n      </div>\n\n      <div class=\"pers-field-group\">\n        <label>SYMBOL</label>\n        <select id=\"input-symbol\">\n          <option value=\"Star\">★ Star</option>\n          <option value=\"Heart\">♥ Heart</option>\n          <option value=\"None\">None</option>\n        </select>\n      </div>\n\n      <div class=\"pers-field-group\">\n        <label>THREAD COLOR</label>\n        <select id=\"input-color\">\n          <option value=\"Black\">⬛ Black</option>\n          <option value=\"White\">⬜ White</option>\n          <option value=\"Gold\">✨ Gold</option>\n        </select>\n      </div>\n\n      <div class=\"pers-field-group\">\n        <label>POSITION</label>\n        <select id=\"input-position\">\n          <option value=\"Chest\">Chest</option>\n          <option value=\"Sleeve\">Sleeve</option>\n          <option value=\"Hem\">Hem</option>\n        </select>\n      </div>\n\n      <div class=\"pers-preview-box\">\n        <div id=\"live-preview-icon\">★</div>\n      </div>\n    </div>\n\n    <div class=\"pers-terms\">\n      <input type=\"checkbox\" id=\"pers-agree-terms\">\n      <label for=\"pers-agree-terms\">\n        The price for personalisation is <strong>+CHF 15.-</strong>. Embroidery extends the delivery time by three working days. Personalised items cannot be returned or exchanged.\n      </label>\n    </div>\n\n    <button type=\"button\" id=\"save-pers-btn\" class=\"btn-save-pers\" disabled>PERSONALISE (+15.-)</button>\n  </div>\n</div>\n\n<style>\n.personalization-wrapper {\n  margin: 15px 0;\n  width: 100%;\n}\n.btn-personalise {\n  width: 100%;\n  background: #ffffff;\n  color: #000000;\n  border: 1px solid #d3d3d3;\n  padding: 12px;\n  font-weight: 500;\n  letter-spacing: 1px;\n  cursor: pointer;\n  transition: all 0.3s ease;\n}\n.btn-personalise:hover {\n  background: #f7f7f7;\n  border-color: #000;\n}\n.pers-summary-box {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  font-size: 13px;\n  padding: 8px 0;\n  border-bottom: 1px solid #eee;\n  margin-bottom: 10px;\n}\n.link-btn {\n  background: none;\n  border: none;\n  text-decoration: underline;\n  cursor: pointer;\n  padding: 0 4px;\n  font-size: 13px;\n}\n\n/* Modal Styles */\n.pers-modal-overlay {\n  display: none;\n  position: fixed;\n  top: 0; left: 0; width: 100%; height: 100%;\n  background: rgba(0,0,0,0.5);\n  z-index: 9999;\n  justify-content: center;\n  align-items: center;\n  padding: 15px;\n}\n.pers-modal-content {\n  background: #fff;\n  padding: 30px;\n  max-width: 650px;\n  width: 100%;\n  position: relative;\n  box-sizing: border-box;\n}\n.close-modal-btn {\n  position: absolute;\n  top: 15px; right: 20px;\n  background: none; border: none; font-size: 28px; cursor: pointer;\n}\n.pers-modal-content h2 {\n  font-size: 22px; margin-top: 0; margin-bottom: 10px; font-weight: normal;\n}\n.pers-subtitle {\n  font-size: 13px; color: #666; margin-bottom: 25px; line-height: 1.4;\n}\n\n/* Grid Layout */\n.pers-grid {\n  display: grid;\n  grid-template-columns: repeat(2, 1fr);\n  gap: 20px;\n}\n.pers-field-group {\n  display: flex;\n  flex-direction: column;\n}\n.pers-field-group label {\n  font-size: 11px; font-weight: bold; margin-bottom: 6px; letter-spacing: 0.5px;\n}\n.pers-field-group input[type=\"text\"], .pers-field-group select {\n  padding: 10px; border: 1px solid #ccc; font-size: 14px; outline: none; width: 100%; box-sizing: border-box;\n}\n.field-help {\n  font-size: 11px; color: #999; margin-top: 4px;\n}\n\n/* Preview Box */\n.pers-preview-box {\n  grid-column: span 1;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  background: #f9f9f9;\n  border: 1px dashed #ccc;\n  min-height: 100px;\n}\n#live-preview-icon {\n  font-size: 40px; color: #000;\n}\n\n/* Terms and Save Button */\n.pers-terms {\n  margin-top: 25px; display: flex; gap: 10px; align-items: flex-start;\n}\n.pers-terms label {\n  font-size: 12px; color: #444; line-height: 1.5; cursor: pointer;\n}\n.btn-save-pers {\n  width: 100%; background: #ccc; color: #fff; border: none; padding: 14px;\n  margin-top: 20px; font-weight: bold; cursor: not-allowed; transition: background 0.3s;\n}\n.btn-save-pers.active {\n  background: #333; color: #fff; cursor: pointer;\n}\n\n/* Mobile Responsive */\n@media (max-width: 600px) {\n  .pers-grid { grid-template-columns: 1fr; gap: 15px; }\n  .pers-modal-content { padding: 20px; height: 90vh; overflow-y: auto; }\n}\n</style>\n\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function() {\n  const modal = document.getElementById(\"pers-modal\");\n  const openBtn = document.getElementById(\"open-pers-modal\");\n  const closeBtn = document.getElementById(\"close-pers-modal\");\n  const saveBtn = document.getElementById(\"save-pers-btn\");\n  const clearBtn = document.getElementById(\"clear-pers-btn\");\n  const editBtn = document.getElementById(\"edit-pers-btn\");\n  const termsCheck = document.getElementById(\"pers-agree-terms\");\n  const textInput = document.getElementById(\"input-text\");\n  const charCount = document.getElementById(\"char-count\");\n  const symbolSelect = document.getElementById(\"input-symbol\");\n  const previewIcon = document.getElementById(\"live-preview-icon\");\n\n  // Summary and Input elements\n  const summaryBox = document.getElementById(\"personalization-summary\");\n  const summaryText = document.getElementById(\"summary-text-values\");\n\n  // Open & Close Modal\n  openBtn.addEventListener(\"click\", () => modal.style.display = \"flex\");\n  closeBtn.addEventListener(\"click\", () => modal.style.display = \"none\");\n\n  // Character Counter & Live Validation\n  textInput.addEventListener(\"input\", function() {\n    charCount.textContent = this.value.length;\n    validateForm();\n  });\n\n  // Dynamic Symbol Preview Change\n  symbolSelect.addEventListener(\"change\", function() {\n    if(this.value === \"Star\") previewIcon.textContent = \"★\";\n    else if(this.value === \"Heart\") previewIcon.textContent = \"♥\";\n    else previewIcon.textContent = \"\";\n  });\n\n  // Checkbox agreement validation\n  termsCheck.addEventListener(\"change\", validateForm);\n\n  function validateForm() {\n    if (textInput.value.trim().length > 0 && termsCheck.checked) {\n      saveBtn.disabled = false;\n      saveBtn.classList.add(\"active\");\n    } else {\n      saveBtn.disabled = true;\n      saveBtn.classList.remove(\"active\");\n    }\n  }\n\n  // Save Settings & Build Summary (P-3 Workflow)\n  saveBtn.addEventListener(\"click\", function() {\n    const textVal = textInput.value.trim();\n    const fontVal = document.getElementById(\"input-font\").value;\n    const symbolVal = symbolSelect.value;\n    const colorVal = document.getElementById(\"input-color\").value;\n    const positionVal = document.getElementById(\"input-position\").value;\n\n    // Apply data to Shopify hidden line item property inputs\n    document.getElementById(\"prop-active\").value = \"Yes\";\n    updateHiddenInput(\"prop-text\", textVal);\n    updateHiddenInput(\"prop-font\", fontVal);\n    updateHiddenInput(\"prop-symbol\", symbolVal);\n    updateHiddenInput(\"prop-color\", colorVal);\n    updateHiddenInput(\"prop-position\", positionVal);\n\n    // Update UI Summary Text\n    summaryText.textContent = `${textVal} / ${fontVal} / ${symbolVal} / ${colorVal} / ${positionVal}`;\n    summaryBox.style.display = \"flex\";\n    openBtn.textContent = \"EDIT PERSONALISATION\";\n    modal.style.display = \"none\";\n  });\n\n  // Clear Personalization Data\n  clearBtn.addEventListener(\"click\", function() {\n    document.getElementById(\"prop-active\").value = \"No\";\n    [\"prop-text\", \"prop-font\", \"prop-symbol\", \"prop-color\", \"prop-position\"].forEach(id => {\n      const el = document.getElementById(id);\n      el.value = \"\";\n      el.disabled = true;\n    });\n\n    // Reset inputs inside modal\n    textInput.value = \"\";\n    charCount.textContent = \"0\";\n    termsCheck.checked = false;\n    saveBtn.disabled = true;\n    saveBtn.classList.remove(\"active\");\n\n    // UI resets\n    summaryBox.style.display = \"none\";\n    openBtn.textContent = \"PERSONALISE\";\n  });\n\n  // Edit Button Action\n  editBtn.addEventListener(\"click\", () => modal.style.display = \"flex\");\n\n  function updateHiddenInput(id, value) {\n    const input = document.getElementById(id);\n    input.value = value;\n    input.disabled = false; // Enabled inputs get sent to Shopify Cart\n  }\n});\n</script>",

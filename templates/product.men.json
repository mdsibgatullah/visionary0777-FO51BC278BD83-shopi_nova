        "code_6HDx64": {
          "type": "code",
          "settings": {
            "code": "<div class=\"personalization-wrapper\">\n  \n  <div id=\"personalization-summary\" class=\"pers-summary-box\" style=\"display: none;\">\n    <span class=\"summary-label\">Personalise: <strong id=\"summary-text-values\"></strong></span>\n    <div class=\"summary-actions\">\n      <button type=\"button\" id=\"edit-pers-btn\" class=\"link-btn\">Edit</button> | \n      <button type=\"button\" id=\"clear-pers-btn\" class=\"link-btn\">Clear</button>\n    </div>\n  </div>\n\n  <button type=\"button\" id=\"open-pers-modal\" class=\"btn-personalise\">PERSONALISE</button>\n</div>\n\n<div id=\"pers-modal\" class=\"pers-modal-overlay\">\n  <div class=\"pers-modal-content\">\n    <button type=\"button\" class=\"close-modal-btn\" id=\"close-pers-modal\">&times;</button>\n    \n    <h2>Personalise your style</h2>\n    <p class=\"pers-subtitle\">Whether as a gift for your loved ones or for yourself, in our USA sewing workshop, we embroider the desired Initials onto your favorite styles with premium 100% linen thread. <a href=\"#\">More Information</a></p>\n    \n    <div class=\"pers-grid\">\n      <div class=\"pers-field-group\">\n        <label>CHARACTERS (<span id=\"char-count\">3</span>/3)</label>\n        <input type=\"text\" id=\"input-text\" maxlength=\"3\" value=\"ASF\" autocomplete=\"off\">\n        <small class=\"field-help\">Letters, numbers and special characters.</small>\n      </div>\n\n      <div class=\"pers-field-group\">\n        <label>FONT</label>\n        <select id=\"input-font\">\n          <option value=\"MODERN\">MODERN</option>\n        </select>\n      </div>\n\n      <div class=\"pers-field-group\">\n        <label>SYMBOL</label>\n        <select id=\"input-symbol\">\n          <option value=\"Star\" selected>★ Star</option>\n          <option value=\"Heart\">♥ Heart</option>\n          <option value=\"Heavenly\"> ✾ Heavenly</option>\n        </select>\n      </div>\n\n      <div class=\"pers-field-group\">\n        <label>THREAD COLOR</label>\n        <select id=\"input-color\">\n          <option value=\"White\" selected> White</option>\n          <option value=\"Natural\">Natural</option>\n    <option value=\"Copper\">100% Copper</option>\n        </select>\n      </div>\n\n      <div class=\"pers-field-group\">\n        <label>POSITION</label>\n        <select id=\"input-position\">\n          <option value=\"Chest\" selected>Chest</option>\n          <option value=\"Sleeve\">Sleeve</option>\n  <option value=\"Hem\">Hem</option>\n        </select>\n      </div>\n\n      <div class=\"pers-preview-box\">\n        <div id=\"live-preview-icon\">★</div>\n      </div>\n    </div>\n\n    <div class=\"pers-terms\">\n      <input type=\"checkbox\" id=\"pers-agree-terms\">\n      <label for=\"pers-agree-terms\">\n        The price for personalisation is <strong>+$30</strong>. Embroidery extends the delivery time by three working days. Personalised items can unfortunately not be returned or exchanged and cannot be subscribed to.\n      </label>\n    </div>\n\n    <button type=\"button\" id=\"save-pers-btn\" class=\"btn-save-pers\" disabled>PERSONALISE (+$30)</button>\n  </div>\n</div>\n\n<style>\n.personalization-wrapper { margin: 15px 0; width: 100%; font-family: inherit; }\n.btn-personalise { width: 100%; background: #ffffff; color: #000000; border: 1px solid #d3d3d3; padding: 14px; font-size: 13px; font-weight: 500; letter-spacing: 2px; cursor: pointer; transition: all 0.3s ease; text-transform: uppercase; }\n.btn-personalise:hover { background: #f7f7f7; border-color: #000; }\n.pers-summary-box { display: flex; justify-content: space-between; align-items: center; font-size: 13px; padding: 10px 0; border-bottom: 1px solid #eee; margin-bottom: 12px; }\n.link-btn { background: none; border: none; text-decoration: underline; cursor: pointer; padding: 0 4px; font-size: 13px; color: #000; }\n.pers-modal-overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 99999; justify-content: center; align-items: center; padding: 15px; }\n.pers-modal-content { background: #fff; padding: 40px; max-width: 680px; width: 100%; position: relative; box-sizing: border-box; }\n.close-modal-btn { position: absolute; top: 15px; right: 20px; background: none; border: none; font-size: 28px; cursor: pointer; color: #666; }\n.pers-modal-content h2 { font-size: 24px; margin-top: 0; margin-bottom: 12px; font-weight: normal; letter-spacing: 0.5px; }\n.pers-subtitle { font-size: 13px; color: #666; margin-bottom: 30px; line-height: 1.5; }\n.pers-subtitle a { color: #000;}\n.pers-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }\n.pers-field-group { display: flex; flex-direction: column; }\n.pers-field-group label { font-size: 11px; font-weight: 600; margin-bottom: 8px; letter-spacing: 0.5px; color: #333; }\n.pers-field-group input[type=\"text\"], .pers-field-group select { padding: 12px; border: 1px solid #ccc; font-size: 13px; outline: none; width: 100%; box-sizing: border-box; background: #fff; }\n.field-help { font-size: 11px; color: #999; margin-top: 6px; line-height: 1.3; }\n.pers-preview-box { grid-column: span 1; display: flex; justify-content: center; align-items: center; background: #f9f9f9; border: 1px solid #eee; min-height: 100px; }\n#live-preview-icon { font-size: 45px; color: #000; }\n.pers-terms { margin-top: 30px; display: flex; gap: 12px; align-items: flex-start; }\n.pers-terms input[type=\"checkbox\"] { margin-top: 3px; }\n.pers-terms label { font-size: 12px; color: #555; line-height: 1.6; cursor: pointer; }\n.btn-save-pers { width: auto; float: right; background: #b5b5b5; color: #fff; border: none; padding: 14px 35px; margin-top: 25px; font-weight: 500; font-size: 13px; letter-spacing: 1px; cursor: not-allowed; text-transform: uppercase; }\n.btn-save-pers.active { background: #000; color: #fff; cursor: pointer; }\n@media (max-width: 650px) { .pers-grid { grid-template-columns: 1fr; gap: 15px; } .pers-modal-content { padding: 25px; max-height: 90vh; overflow-y: auto; } .btn-save-pers { width: 100%; float: none; margin-top: 20px; } }\n</style>\n\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function() {\n  const PERSONALIZATION_VARIANT_ID = \"52086759948589\"; \n\n  const modal = document.getElementById(\"pers-modal\");\n  const openBtn = document.getElementById(\"open-pers-modal\");\n  const closeBtn = document.getElementById(\"close-pers-modal\");\n  const saveBtn = document.getElementById(\"save-pers-btn\");\n  const clearBtn = document.getElementById(\"clear-pers-btn\");\n  const editBtn = document.getElementById(\"edit-pers-btn\");\n  const termsCheck = document.getElementById(\"pers-agree-terms\");\n  const textInput = document.getElementById(\"input-text\");\n  const charCount = document.getElementById(\"char-count\");\n  const symbolSelect = document.getElementById(\"input-symbol\");\n  const previewIcon = document.getElementById(\"live-preview-icon\");\n  const summaryBox = document.getElementById(\"personalization-summary\");\n  const summaryText = document.getElementById(\"summary-text-values\");\n\n  let hasPersonalization = false;\n  let savedProperties = {};\n\n  openBtn.addEventListener(\"click\", () => modal.style.display = \"flex\");\n  closeBtn.addEventListener(\"click\", () => modal.style.display = \"none\");\n  editBtn.addEventListener(\"click\", () => modal.style.display = \"flex\");\n\n  textInput.addEventListener(\"input\", function() {\n    charCount.textContent = this.value.length;\n    validateForm();\n  });\n\n    symbolSelect.addEventListener(\"change\", function() {\n  if(this.value === \"Star\") {\n    previewIcon.innerHTML = \"★\";\n  }\n  else if(this.value === \"Heart\") {\n    previewIcon.innerHTML = \"♥\";\n  }\n  else if(this.value === \"Heavenly\") {\n    previewIcon.innerHTML = `\n      <img \n        src=\"https://cdn.shopify.com/s/files/1/0883/8860/0109/files/Brand_Flower_Symbol-removebg_6_a3917234-8750-456f-8f5b-35b786ca5cff.png?v=1780119598\"\n        alt=\"Heavenly\"\n        style=\"width:70px;height:70px;object-fit:contain;\"\n      >\n    `;\n  }\n  else {\n    previewIcon.innerHTML = \"\";\n  }\n});\n\n  termsCheck.addEventListener(\"change\", validateForm);\n\n  function validateForm() {\n    if (textInput.value.trim().length > 0 && termsCheck.checked) {\n      saveBtn.disabled = false;\n      saveBtn.classList.add(\"active\");\n    } else {\n      saveBtn.disabled = true;\n      saveBtn.classList.remove(\"active\");\n    }\n  }\n\n  saveBtn.addEventListener(\"click\", function() {\n    const textVal = textInput.value.trim();\n    const fontVal = document.getElementById(\"input-font\").value;\n    const symbolVal = symbolSelect.value;\n    const colorVal = document.getElementById(\"input-color\").value;\n    const positionVal = document.getElementById(\"input-position\").value;\n\n    savedProperties = {\n      \"Text\": textVal,\n      \"Font\": fontVal,\n      \"Symbol\": symbolVal,\n      \"Thread Color\": colorVal,\n      \"Position\": positionVal\n    };\n\n    summaryText.textContent = `${textVal} / ${fontVal} / ${symbolVal} / ${colorVal} / ${positionVal}`;\n    summaryBox.style.display = \"flex\";\n    openBtn.textContent = \"EDIT PERSONALISATION\";\n    hasPersonalization = true;\n    modal.style.display = \"none\";\n  });\n\n  clearBtn.addEventListener(\"click\", function() {\n    savedProperties = {};\n    hasPersonalization = false;\n    textInput.value = \"ASF\";\n    charCount.textContent = \"3\";\n    termsCheck.checked = false;\n    saveBtn.disabled = true;\n    saveBtn.classList.remove(\"active\");\n    summaryBox.style.display = \"none\";\n    openBtn.textContent = \"PERSONALISE\";\n  });\n\n  // BROADCAST DRAWER COMPATIBLE BUNDLE LOGIC\n  const formSubmitBtn = document.querySelector('[data-add-to-cart], .product-form__submit, button[name=\"add\"]');\n\n  if (formSubmitBtn) {\n    formSubmitBtn.addEventListener(\"click\", function(e) {\n      if (hasPersonalization) {\n        e.preventDefault();\n        e.stopPropagation();\n        e.stopImmediatePropagation();\n\n        const form = formSubmitBtn.closest('form[action*=\"/cart/add\"]');\n        let mainVariantId = form.querySelector('[name=\"id\"]')?.value || window.meta?.product?.variants[0]?.id;\n        const mainQty = form.querySelector('[name=\"quantity\"]')?.value || 1;\n\n        formSubmitBtn.classList.add('loading');\n        formSubmitBtn.disabled = true;\n\n        // Step 1: Main Product-ti empty options (no properties) soho add hocche\n        fetch('/cart/add.js', {\n          method: 'POST',\n          headers: { 'Content-Type': 'application/json' },\n          body: JSON.stringify({\n            id: parseInt(mainVariantId),\n            quantity: parseInt(mainQty)\n          })\n        })\n        .then(() => {\n          // Step 2: Main product add howar por Add-on ($15) product properites soho add hobe\n          return fetch('/cart/add.js', {\n            method: 'POST',\n            headers: { 'Content-Type': 'application/json' },\n            body: JSON.stringify({\n              id: parseInt(PERSONALIZATION_VARIANT_ID),\n              quantity: parseInt(mainQty),\n              properties: {\n                \"Linked Style\": window.meta?.product?.name || \"Main Style\",\n                ...savedProperties\n              }\n            })\n          });\n        })\n        .then(response => response.json())\n        .then(() => {\n          // Step 3: Duti product successfully backend e add hoye gele Cart update ebong Drawer trigger hobe\n          return fetch('/cart.js').then(res => res.json());\n        })\n        .then(cartData => {\n          formSubmitBtn.classList.remove('loading');\n          formSubmitBtn.disabled = false;\n\n          // Broadcast Drawer render context force dispatch\n          document.dispatchEvent(new CustomEvent('theme:cart:change', {\n            bubbles: true,\n            detail: { cart: cartData }\n          }));\n\n          // Drawer slide-out animation open trigger\n          document.dispatchEvent(new CustomEvent('cart:toggle', {\n            bubbles: true\n          }));\n\n          // Alternate structural call for theme scripts\n          if (window.theme && window.theme.CartDrawer) {\n            window.theme.CartDrawer.open();\n          }\n        })\n        .catch(error => {\n          console.error('Drawer Error:', error);\n          form.submit();\n        });\n      }\n    }, true); \n  }\n});\n\n</script>",

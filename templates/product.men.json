          "settings": {
            "code": "<div class=\"personalization-wrapper\">\n  \n  <div id=\"personalization-summary\" class=\"pers-summary-box\" style=\"display: none;\">\n    <span class=\"summary-label\">Personalise: <strong id=\"summary-text-values\"></strong></span>\n    <div class=\"summary-actions\">\n      <button type=\"button\" id=\"edit-pers-btn\" class=\"link-btn\">Edit</button> | \n      <button type=\"button\" id=\"clear-pers-btn\" class=\"link-btn\">Clear</button>\n    </div>\n  </div>\n\n  <button type=\"button\" id=\"open-pers-modal\" class=\"btn-personalise\">PERSONALISE</button>\n</div>\n\n<div id=\"pers-modal\" class=\"pers-modal-overlay\">\n  <div class=\"pers-modal-content\">\n    <button type=\"button\" class=\"close-modal-btn\" id=\"close-pers-modal\">&times;</button>\n    \n    <h2>Personalise your style</h2>\n    <p class=\"pers-subtitle\">\n      Whether as a gift for your loved ones or for yourself, in our USA sewing workshop, we embroider the desired Initials onto your favorite styles. \n      <a href=\"#\">More Information</a>\n    </p>\n    \n    <div class=\"pers-grid\">\n      <div class=\"pers-field-group\">\n        <label>CHARACTERS (<span id=\"char-count\">3</span>/3)</label>\n        <input type=\"text\" id=\"input-text\" maxlength=\"3\" value=\"ASF\" autocomplete=\"off\">\n        <small class=\"field-help\">Letters, numbers and special characters.</small>\n      </div>\n\n      <div class=\"pers-field-group\">\n        <label>FONT</label>\n        <select id=\"input-font\">\n          <option value=\"MODERN\">MODERN</option>\n        </select>\n      </div>\n\n      <div class=\"pers-field-group\">\n        <label>SYMBOL</label>\n        <select id=\"input-symbol\">\n          <option value=\"Star\" selected>★ Star</option>\n          <option value=\"Heart\">♥ Heart</option>\n          <option value=\"Heavenly\"> ✾ Heavenly</option>\n        </select>\n      </div>\n\n      <div class=\"pers-field-group\">\n        <label>THREAD COLOR</label>\n        <select id=\"input-color\">\n          <option value=\"White\" selected>White</option>\n          <option value=\"Natural\">Natural</option>\n          <option value=\"Copper\">100% Copper</option>\n        </select>\n      </div>\n\n      <div class=\"pers-field-group\">\n        <label>POSITION</label>\n        <select id=\"input-position\">\n          <option value=\"Chest\" selected>Chest</option>\n          <option value=\"Sleeve\">Sleeve</option>\n          <option value=\"Hem\">Hem</option>\n        </select>\n      </div>\n\n      <div class=\"pers-preview-box\">\n        <div id=\"live-preview-icon\">★</div>\n      </div>\n    </div>\n\n    <div class=\"pers-terms\">\n      <input type=\"checkbox\" id=\"pers-agree-terms\">\n      <label for=\"pers-agree-terms\">\n        The price for personalisation is <strong>+$15</strong>. Embroidery extends the delivery time by three working days. Personalised items can unfortunately not be returned or exchanged and cannot be subscribed to.\n      </label>\n    </div>\n\n    <button type=\"button\" id=\"save-pers-btn\" class=\"btn-save-pers\" disabled>\n      PERSONALISE (+$15)\n    </button>\n  </div>\n</div>\n\n<style>\n.personalization-wrapper { margin: 15px 0; width: 100%; font-family: inherit; }\n.btn-personalise { width: 100%; background: #fff; color: #000; border: 1px solid #d3d3d3; padding: 14px; font-size: 13px; letter-spacing: 2px; cursor: pointer; text-transform: uppercase; }\n.btn-personalise:hover { background: #f7f7f7; border-color: #000; }\n\n.pers-summary-box { display:flex; justify-content:space-between; font-size:13px; padding:10px 0; border-bottom:1px solid #eee; margin-bottom:12px; }\n.link-btn { background:none; border:none; text-decoration:underline; cursor:pointer; }\n\n.pers-modal-overlay { display:none; position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:99999; justify-content:center; align-items:center; padding:15px; }\n.pers-modal-content { background:#fff; padding:40px; max-width:680px; width:100%; position:relative; }\n\n.close-modal-btn { position:absolute; right:20px; top:15px; font-size:28px; background:none; border:none; cursor:pointer; }\n\n.pers-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:20px; }\n\n.pers-field-group label { font-size:11px; font-weight:600; margin-bottom:8px; display:block; }\n\n.pers-field-group input, .pers-field-group select {\n  padding:12px; border:1px solid #ccc; width:100%;\n}\n\n.pers-preview-box { display:flex; align-items:center; justify-content:center; background:#f9f9f9; min-height:100px; }\n\n#live-preview-icon { font-size:45px; }\n\n.btn-save-pers {\n  float:right; padding:14px 35px; background:#b5b5b5; color:#fff;\n  border:none; cursor:not-allowed;\n}\n\n.btn-save-pers.active { background:#000; cursor:pointer; }\n\n@media(max-width:650px){\n  .pers-grid{grid-template-columns:1fr;}\n}\n</style>\n\n<script>\n\ndocument.addEventListener(\"DOMContentLoaded\", function () {\n\n  const PERSONALIZATION_VARIANT_ID = \"52086759948589\";\n\n  const modal = document.getElementById(\"pers-modal\");\n  const openBtn = document.getElementById(\"open-pers-modal\");\n  const closeBtn = document.getElementById(\"close-pers-modal\");\n  const saveBtn = document.getElementById(\"save-pers-btn\");\n  const termsCheck = document.getElementById(\"pers-agree-terms\");\n  const textInput = document.getElementById(\"input-text\");\n  const charCount = document.getElementById(\"char-count\");\n  const symbolSelect = document.getElementById(\"input-symbol\");\n  const previewIcon = document.getElementById(\"live-preview-icon\");\n  const summaryBox = document.getElementById(\"personalization-summary\");\n  const summaryText = document.getElementById(\"summary-text-values\");\n\n  let hasPersonalization = false;\n  let savedProperties = {};\n\n  // MODAL\n  openBtn.addEventListener(\"click\", () => modal.style.display = \"flex\");\n  closeBtn.addEventListener(\"click\", () => modal.style.display = \"none\");\n\n  textInput.addEventListener(\"input\", function () {\n    charCount.textContent = this.value.length;\n    validateForm();\n  });\n\n  symbolSelect.addEventListener(\"change\", function () {\n    if (this.value === \"Star\") previewIcon.innerHTML = \"★\";\n    else if (this.value === \"Heart\") previewIcon.innerHTML = \"♥\";\n    else if (this.value === \"Heavenly\") {\n      previewIcon.innerHTML = `<img src=\"https://cdn.shopify.com/s/files/1/0883/8860/0109/files/Brand_Flower_Symbol-removebg_6_a3917234-8750-456f-8f5b-35b786ca5cff.png?v=1780119598\" style=\"width:70px;height:70px;object-fit:contain;\">`;\n    }\n  });\n\n  termsCheck.addEventListener(\"change\", validateForm);\n\n  function validateForm() {\n    saveBtn.disabled = !(textInput.value.trim() && termsCheck.checked);\n    saveBtn.classList.toggle(\"active\", !saveBtn.disabled);\n  }\n\n  // SAVE\n  saveBtn.addEventListener(\"click\", function () {\n\n    savedProperties = {\n      Text: textInput.value,\n      Font: document.getElementById(\"input-font\").value,\n      Symbol: symbolSelect.value,\n      Color: document.getElementById(\"input-color\").value,\n      Position: document.getElementById(\"input-position\").value\n    };\n\n    summaryText.textContent = Object.values(savedProperties).join(\" / \");\n    summaryBox.style.display = \"flex\";\n\n    hasPersonalization = true;\n    modal.style.display = \"none\";\n  });\n\n  // CLEAR\n  document.getElementById(\"clear-pers-btn\").addEventListener(\"click\", function () {\n    hasPersonalization = false;\n    savedProperties = {};\n    summaryBox.style.display = \"none\";\n  });\n\n  // ⭐ IMPORTANT: ONLY ADD ADD-ON PRODUCT AFTER CART UPDATE\n  document.addEventListener(\"submit\", function (e) {\n\n    const form = e.target;\n\n    if (!form.matches('form[action*=\"/cart/add\"]')) return;\n    if (!hasPersonalization) return;\n\n    e.preventDefault();\n\n    const formData = new FormData(form);\n    const id = formData.get(\"id\");\n    const qty = formData.get(\"quantity\") || 1;\n\n    const btn = form.querySelector('[type=\"submit\"]');\n    if (btn) btn.classList.add(\"loading\");\n\n    // STEP 1: Let Shopify handle main product (important fix)\n    fetch('/cart/add.js', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({\n        id: parseInt(id),\n        quantity: parseInt(qty)\n      })\n    })\n\n    // STEP 2: add personalization product\n    .then(() => {\n      return fetch('/cart/add.js', {\n        method: 'POST',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify({\n          id: parseInt(PERSONALIZATION_VARIANT_ID),\n          quantity: parseInt(qty),\n          properties: {\n            ...savedProperties\n          }\n        })\n      });\n    })\n\n    // STEP 3: redirect cart page\n    .then(() => {\n      window.location.href = \"/cart\";\n    })\n\n    .catch((err) => {\n      console.error(err);\n      form.submit();\n    });\n\n  }, true);\n\n});\n\n</script>",
            "padding_bottom": 16
          }
        },
        "code_dKMMdT": {

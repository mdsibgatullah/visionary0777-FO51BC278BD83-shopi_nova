    "section_reviews_gNLnLw": {
      "type": "section-reviews",
      "blocks": {
        "review_WqMUXa": {
          "type": "review",
          "settings": {
            "title": "Cameron J.",
            "subheading": "",
            "review_text": "\"I love the soothing, cooling effect on my skin. The Heavenly fabric is really breathable and lightweight, and feels like I am not wearing anything. Like a second layer of skin. Instantly feel relief each time I put them on, and look forward to wearing them. Love the sleek, modern, minimalist fit.\"",
            "review_url": ""
          }
        },
        "review_WMpPMm": {
          "type": "review",
          "settings": {
            "title": "Sophia M.",
            "subheading": "",
            "review_text": "\"Heavenly Essentials has completely changed the way I feel about my everyday wear. I purchased linen underwear because I was having yeast infections. These are unbelievably soft and I consider them as an investment for my health.\"",
            "review_url": ""
          }
        },
        "review_wX6HG6": {
          "type": "review",
          "settings": {
            "title": "Emily R.",
            "subheading": "",
            "review_text": "\"For years I have searched for organic linen undergarments and was never able to find anything that was high-quality with modern styles, until Heavenly Essentials. I love the designs that are sophisticated and comfortable. Organic knitted linen fabric is impossible to find anywhere else. Finding this store has truly been a God-send. Definitely my new go-to.\"",
            "review_url": ""
          }
        },
        "review_YBNyjV": {
          "type": "review",
          "settings": {
            "title": "Megan T.",
            "subheading": "",
            "review_text": "\"Heavenly Essentials is eco-friendly and sustainable, which is really important to me. I love how easy it is to find everything on their website, and the customer service is top-notch. This store has earned a loyal customer in me!\"",
            "review_url": ""
          }
        }
      },
      "block_order": [
        "review_WqMUXa",

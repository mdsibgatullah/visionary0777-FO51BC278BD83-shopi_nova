        "text_wB8yCJ": {
          "type": "text",
          "settings": {
            "text": "<p>Fully regenerative - Zero waste</p><p>Better for your body (natural fibers, plant-based) </p><p>Chemical-free, Fertility-friendly </p><p>More durable & longer lasting than synthetics </p><p>Conserves Earth's most precious resource: Water</p><p>Turns back to dirt at end-of-life & improves biodiversity </p><p>Sustainability helps combat climate change</p>",
            "text_size": 4,
            "text_style": "font-body",

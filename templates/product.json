          "disabled": true,
          "settings": {
            "code": "<div class=\"acc acc-subscription\" style=\"display: block;\" data-selected-sub-index=\"1\"> <div class=\"acc-item open\"> <button type=\"button\" class=\"acc-header\"> <span>Buy or gift as a subscription</span> <span class=\"acc-toggle\">−</span></button> <div class=\"acc-body\" style=\"max-height: 210px;\"> <label class=\"sub-option\"> <input type=\"radio\" name=\"subscription-ui\" class=\"sub-ui-radio\" data-target=\"1\"> <span>Deliver every month</span></label> <label class=\"sub-option\"> <input type=\"radio\" name=\"subscription-ui\" class=\"sub-ui-radio\" data-target=\"2\"> <span>Deliver every 6 months</span></label> <label class=\"sub-option\"> <input type=\"radio\" name=\"subscription-ui\" class=\"sub-ui-radio\" data-target=\"3\"> <span>Deliver every 12 months</span></label> <p style=\"margin-top: 7px;\">\n        Automatic renewal, skipping, or cancellation of subscriptions is possible at any time. <a href=\"/policies/subscription-policy\" title=\"View subscription policy\" target=\"_blank\">View subscription policy</a></p></div></div>\n</div>\n\n<style>\n  .product-block--abbonement-enhancer .acc.acc-subscription {\n    margin-bottom: -20px;\n    border-bottom: 0;\n    display: none;\n  }\n\n  .acc-subscription .acc-header {\n    line-height: 21px;\n  }\n\n  .acc-subscription .acc-item.open .acc-header {\n    padding-bottom: 0;\n  }\n\n  .acc-subscription .acc-body {\n    padding: 0 20px;\n  }\n\n  .acc-subscription .acc-item.open .acc-body {\n    padding-top: 0;\n  }\n\n  .sub-option {\n    display: flex;\n    gap: 10px;\n    align-items: center;\n    cursor: pointer;\n  }\n\n  .sub-option input[type=\"radio\"] {\n    width: 12px;\n    height: 12px;\n    accent-color: #2E3234;\n  }\n\n  .product-block.product-block--\\@app:has(.shopify_subscriptions_app_container) {\n    display:none;\n  }\n</style>\n\n<script>\n//  Shopify Subscriptions sync (variant -> block, ui -> app, dealing with the apps bugs via custom js..)\ndocument.addEventListener(\"DOMContentLoaded\", () => {\n  const container = document.querySelector(\".shopify_subscriptions_app_container\");\n  const dropdown  = document.querySelector(\".custom-dropdown\");\n  const variantEl = document.querySelector(\"[data-variant-option]\");\n  const sellingPlanJson = document.querySelector(\"[data-acc-subscription-selling-plans]\");\n  const productForm = document.querySelector(\".product_form form, form[action*='/cart/add']\");\n  const subscriptionUi = document.querySelector(\".acc.acc-subscription\");\n  let sellingPlanMap = {};\n\n  if (!container) return;\n  if (subscriptionUi) subscriptionUi.style.display = \"block\";\n\n  try {\n    sellingPlanMap = JSON.parse(sellingPlanJson?.textContent || \"{}\");\n  } catch (error) {\n    console.warn(\"[subs] selling plan map parse failed\", error);\n  }\n\n  const HIDDEN = \"shopify_subscriptions_app_block--hidden\";\n\n  // Stores the subscription radio index selected by the user.\n  // Persists across variant changes so selecting subscription before size works.\n  let pendingSubIndex = null;\n  let pendingDeselectIndex = null;\n\n  function getVariantId() {\n    // The custom dropdown updates first; prefer it to avoid stale hidden variant ids.\n    const activeLi = dropdown?.querySelector('li[data-variant-id].selected');\n    if (activeLi) return activeLi.getAttribute(\"data-variant-id\");\n\n    const variantSelectionId = productForm?.closest(\".product_form\")?.querySelector(\"variant-selection\")?.getAttribute(\"variant\");\n    if (variantSelectionId && variantSelectionId !== \"not-selected\" && variantSelectionId !== \"unavailable\") return variantSelectionId;\n\n    const formVariantId = productForm?.querySelector('[name=\"id\"]')?.value;\n    if (formVariantId && formVariantId !== \"not-selected\") return formVariantId;\n\n    // Fallback: select value (skip placeholder \"not-selected\")\n    if (variantEl?.tagName === \"SELECT\" && variantEl.value && variantEl.value !== \"not-selected\") {\n      return variantEl.value;\n    }\n\n    return null;\n  }\n\n  function setProductFormVariant(variantId) {\n    const variantField = productForm?.querySelector('[name=\"id\"]');\n    if (variantField && variantId) {\n      variantField.value = variantId;\n    }\n  }\n\n  function getSellingPlanId(variantId, subIndex) {\n    if (!variantId || !Number.isInteger(subIndex)) return null;\n    const plans = sellingPlanMap[String(variantId)] || [];\n    return plans[subIndex - 1] || null;\n  }\n\n  function setProductFormSellingPlan(sellingPlanId) {\n    if (!productForm) return;\n\n    let input = productForm.querySelector('[name=\"selling_plan\"][data-acc-selling-plan]');\n    if (!input) {\n      input = document.createElement(\"input\");\n      input.type = \"hidden\";\n      input.name = \"selling_plan\";\n      input.setAttribute(\"data-acc-selling-plan\", \"true\");\n      productForm.appendChild(input);\n    }\n\n    if (sellingPlanId) {\n      input.value = sellingPlanId;\n      input.disabled = false;\n      if (subscriptionUi) subscriptionUi.dataset.selectedSellingPlan = sellingPlanId;\n    } else {\n      input.value = \"\";\n      input.disabled = true;\n      if (subscriptionUi) delete subscriptionUi.dataset.selectedSellingPlan;\n    }\n  }\n\n  function prepareUiSelection(ui) {\n    const index = Number(ui.dataset.target);\n    if (!Number.isFinite(index)) return;\n\n    const isDeselect = pendingSubIndex === index || ui.checked;\n    if (isDeselect) {\n      pendingDeselectIndex = index;\n      setProductFormSellingPlan(null);\n      return;\n    }\n\n    pendingDeselectIndex = null;\n    pendingSubIndex = index;\n    if (subscriptionUi) subscriptionUi.dataset.selectedSubIndex = String(index);\n    setProductFormSellingPlan(getSellingPlanId(getVariantId(), index));\n  }\n\n  function applyCurrentSubscriptionState() {\n    if (pendingSubIndex === null) {\n      const checkedUi = subscriptionUi?.querySelector(\".sub-ui-radio:checked\");\n      const checkedIndex = Number(checkedUi?.dataset.target);\n      if (Number.isInteger(checkedIndex)) {\n        pendingSubIndex = checkedIndex;\n      }\n    }\n\n    if (pendingSubIndex === null) {\n      setProductFormSellingPlan(null);\n      if (subscriptionUi) delete subscriptionUi.dataset.selectedSubIndex;\n      return;\n    }\n\n    if (subscriptionUi) subscriptionUi.dataset.selectedSubIndex = String(pendingSubIndex);\n    setProductFormSellingPlan(getSellingPlanId(getVariantId(), pendingSubIndex));\n  }\n\n  function showBlock(variantId) {\n    if (!variantId) return console.log(\"[subs] no variantId\");\n\n    container.querySelectorAll(\".shopify_subscriptions_app_block\")\n      .forEach(b => b.classList.add(HIDDEN));\n\n    const block = container.querySelector(\n      `.shopify_subscriptions_app_block[data-variant-id=\"${variantId}\"]`\n    );\n\n    if (!block) return console.log(\"[subs] no block for variant\", variantId);\n\n    block.classList.remove(HIDDEN);\n    console.log(\"[subs] show block for variant\", variantId);\n  }\n\n  function clickAppRadio(index) {\n    const radios = container.querySelectorAll(\n      `.shopify_subscriptions_app_block:not(.${HIDDEN}) input[type=\"radio\"]`\n    );\n    const el = radios[index];\n    if (!el) return console.log(\"[subs] no app radio at index\", index);\n\n    el.click();\n    console.log(\"[subs] clicked app radio index\", index);\n  }\n\n  // Reset the hidden app subscription radios to \"one-time purchase\" (index 0)\n  function resetAppSubscription() {\n    const visibleBlock = container.querySelector(\n      `.shopify_subscriptions_app_block:not(.${HIDDEN})`\n    );\n    if (!visibleBlock) return;\n    const oneTimeRadio = visibleBlock.querySelector('input[type=\"radio\"]');\n    if (oneTimeRadio) oneTimeRadio.click();\n  }\n\n  function sync({ variantId = null, subIndex = null } = {}) {\n    const id = variantId || getVariantId();\n\n    // Store pending subscription index if provided\n    if (Number.isInteger(subIndex)) {\n      pendingSubIndex = subIndex;\n      if (subscriptionUi) subscriptionUi.dataset.selectedSubIndex = String(subIndex);\n    }\n\n    // Show the correct subscription app block for the selected variant\n    showBlock(id);\n\n    // If no variant selected yet, defer — pendingSubIndex is stored for later\n    if (!id) {\n      console.log(\"[subs] no variant selected, subscription choice stored for later\");\n      setProductFormSellingPlan(null);\n      return;\n    }\n\n    // Determine which index to apply: explicit subIndex or previously stored one\n    const indexToApply = Number.isInteger(subIndex) ? subIndex : pendingSubIndex;\n\n    if (Number.isInteger(indexToApply)) {\n      setProductFormSellingPlan(getSellingPlanId(id, indexToApply));\n      requestAnimationFrame(() => setTimeout(() => clickAppRadio(indexToApply), 50));\n    } else {\n      setProductFormSellingPlan(null);\n      requestAnimationFrame(() => setTimeout(resetAppSubscription, 50));\n    }\n  }\n\n  // Dropdown (size selector) click => sync subscription block for new variant\n  dropdown?.addEventListener(\"click\", (e) => {\n    const li = e.target.closest(\"li[data-variant-id]\");\n    if (!li) return; // Ignore clicks on the dropdown header/arrow\n\n    const newVariantId = li.getAttribute(\"data-variant-id\");\n    setProductFormVariant(newVariantId);\n\n    // If user has NOT selected a subscription, reset the app radios\n    // If user HAS selected one (pendingSubIndex), keep it and re-apply\n    if (pendingSubIndex === null) {\n      document.querySelectorAll('.acc.acc-subscription input').forEach((input) => {\n        input.checked = false;\n      });\n      setProductFormSellingPlan(null);\n    } else {\n      setProductFormSellingPlan(getSellingPlanId(newVariantId, pendingSubIndex));\n    }\n\n    setTimeout(() => {\n      variantEl?.dispatchEvent(\n        new Event(\"change\", { bubbles: true })\n      );\n      // After the theme processes the variant change, sync the subscription block\n      setTimeout(() => {\n        sync({ variantId: newVariantId });\n\n        // Re-check the UI radio to reflect the pending selection visually\n        if (pendingSubIndex !== null) {\n          const uiRadios = document.querySelectorAll('.acc.acc-subscription .sub-ui-radio');\n          uiRadios.forEach(r => {\n            r.checked = (Number(r.dataset.target) === pendingSubIndex);\n          });\n        }\n      }, 100);\n    }, 500);\n  });\n\n  // Prepare the hidden selling_plan before Shopify's app radios finish updating.\n  document.addEventListener(\"pointerdown\", (e) => {\n    const option = e.target.closest(\".sub-option\");\n    const ui = e.target.closest(\".sub-ui-radio\") || option?.querySelector(\".sub-ui-radio\");\n    if (!ui) return;\n\n    prepareUiSelection(ui);\n  });\n\n  // UI radio click => toggle off the current subscription choice.\n  document.addEventListener(\"click\", (e) => {\n    const option = e.target.closest(\".sub-option\");\n    const ui = e.target.closest(\".sub-ui-radio\") || option?.querySelector(\".sub-ui-radio\");\n    if (!ui) return;\n\n    const index = Number(ui.dataset.target);\n    if (!Number.isFinite(index)) return console.log(\"[subs] ui radio missing data-target\");\n\n    if (pendingDeselectIndex === index) {\n      setTimeout(() => {\n        ui.checked = false;\n        pendingSubIndex = null;\n        pendingDeselectIndex = null;\n        if (subscriptionUi) delete subscriptionUi.dataset.selectedSubIndex;\n        console.log(\"[subs] subscription deselected\");\n        setProductFormSellingPlan(null);\n        resetAppSubscription();\n      }, 0);\n    }\n  });\n\n  // UI radio change => store and apply to app.\n  document.addEventListener(\"change\", (e) => {\n    const ui = e.target.closest(\".sub-ui-radio\");\n    if (!ui) return;\n\n    const index = Number(ui.dataset.target);\n    if (!Number.isFinite(index)) return console.log(\"[subs] ui radio missing data-target\");\n    if (pendingDeselectIndex === index) return;\n\n    console.log(\"[subs] ui changed -> index\", index);\n    pendingDeselectIndex = null;\n    sync({ subIndex: index });\n\n    document.querySelector('[name=add]')?.scrollIntoView({\n      behavior: \"smooth\",\n      block: \"center\"\n    });\n  });\n\n  document.addEventListener(\"pointerdown\", (e) => {\n    if (!e.target.closest('[name=\"add\"], .ajax-submit, [data-add-to-cart-trigger]')) return;\n    applyCurrentSubscriptionState();\n  }, true);\n\n  document.addEventListener(\"click\", (e) => {\n    if (!e.target.closest('[name=\"add\"], .ajax-submit, [data-add-to-cart-trigger]')) return;\n    applyCurrentSubscriptionState();\n  }, true);\n\n  // Also listen for the native select change event (variant change from other sources)\n  if (variantEl) {\n    variantEl.addEventListener(\"change\", () => {\n      const id = getVariantId();\n      if (id) {\n        // Small delay to let the theme finish processing\n        setTimeout(() => sync({ variantId: id }), 150);\n      }\n    });\n  }\n\n  sync();\n});\n</script>",

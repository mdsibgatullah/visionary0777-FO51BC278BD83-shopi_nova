      "settings": {
        "code": "<div class=\"plant-colors-waitlist-section\">\n  <div class=\"waitlist-container\">\n    <h2 class=\"waitlist-title\">Sign up for the next drop: August 28.</h2>\n    <p class=\"waitlist-subtitle\">get notified the second our drops go live</p>\n    \n    {% form 'customer', class: 'waitlist-form' %}\n      <input type=\"hidden\" name=\"contact[tags]\" value=\"plant-colors-waitlist\">\n      \n      <div class=\"form-group-inputs\">\n        <input \n          type=\"email\" \n          name=\"contact[email]\" \n          class=\"waitlist-input-email\" \n          placeholder=\"email\" \n          required\n        >\n        <button type=\"submit\" class=\"waitlist-btn-submit\">\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" style=\"margin-right: 8px; vertical-align: middle;\">\n            <path d=\"M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z\"></path>\n            <polyline points=\"22,6 12,13 2,6\"></polyline>\n          </svg>\n          JOIN WAITLIST\n        </button>\n      </div>\n\n      {% if form.posted_successfully? %}\n        <p class=\"waitlist-success\">Thank you for joining our waitlist!</p>\n      {% endif %}\n    {% endform %}\n  </div>\n</div>\n\n<style>\n.plant-colors-waitlist-section {\n  background-color: #F7F9FA;\n  padding: 80px 20px;\n  text-align: center;\n}\n.waitlist-container {\n  max-width:100%;\n  margin: 0 auto;\n}\n.waitlist-title {\n  font-size: 32px;\n  font-weight: 500;\n  color: #212121;\n  margin-bottom: 15px;\n}\n.waitlist-subtitle {\n  font-size: 16px;\n  color: #222222;\n  margin-bottom: 30px;\n}\n.form-group-inputs {\n  display: flex;\n  justify-content: center;\n  gap: 15px;\n  align-items: center;\n}\n.waitlist-input-email {\n  width: 250px;\n  padding: 15px 20px;\n  border: 1px solid #cccccc;\n  border-radius: 8px;\n  background-color: #F7F9FA;\n  font-size: 16px;\n}\n.waitlist-btn-submit {\n  background-color: #262626;\n  color: #ffffff;\n  padding: 15px 30px;\n  border: none;\n  border-radius: 25px; /* Pill shape onujayi high radius */\n  font-size: 14px;\n  font-weight: bold;\n  letter-spacing: 1px;\n  cursor: pointer;\n  display: flex;\n  align-items: center;\n}\n.waitlist-btn-submit:hover {\n  background-color: #000000;\n  border: 1px solid #cccccc;\n}\n.waitlist-success {\n  color: green;\n  margin-top: 15px;\n}\n\n/* Responsive Handling */\n@media (max-width: 768px) {\n  .form-group-inputs {\n    flex-direction: column;\n    width: 100%;\n  }\n  .waitlist-input-email {\n    width: 100%;\n  }\n  .waitlist-btn-submit {\n    width: 100%;\n    justify-content: center;\n  }\n}\n</style>",

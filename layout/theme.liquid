          pointer-events: none !important;
        }

        /* ২. ফাঁকা জায়গা দূর করার ম্যাজিক সিএসএস (ফ্লেক্স ও হাইট অটো রিসেট) */
        .product__thumbs,
        .product__thumbs_holder {
          display: flex !important;
          flex-direction: column !important;
          height: auto !important;
          min-height: unset !important;
          max-height: unset !important;
          transform: none !important; /* স্লাইডারের পজিশনিং ব্রেক করা */
        }

        /* ৩. একটিভ থাম্বনেইলগুলোর পজিশন ঠিক রাখা যাতে সিরিয়ালি বসে */
        .product__thumbs .product__thumb:not(.v-strict-hide) {
          position: relative !important;
          top: 0 !important;
          left: 0 !important;
          transform: none !important;
          margin-bottom: 8px !important; /* থাম্বনেইলগুলোর মাঝের গ্যাপ */
          display: block !important;
        }
      </style>

      <script>
      (function() {
        function getSelectedColor() {
          let color = '';

          // ব্রডকাস্ট কাস্টম সোয়াচ ইনপুট থেকে সিলেক্টেড ভ্যালু নেওয়া
          const activeRadio = document.querySelector('.swatch input:checked, .variant-input input:checked, input[type="radio"]:checked');
          if (activeRadio) {
            const val = activeRadio.value.trim().toLowerCase();
            if (!['xs','s','m','l','xl','2xl'].includes(val)) {
              color = val;
            }
          }

          // ব্যাকআপ লেবেল ট্র্যাকিং
          if (!color) {
            const labelEl = document.querySelector('[data-variant-label], .product-form__selected-value, .ProductForm__SelectedValue, .variant-input__option-value');
            if (labelEl) color = labelEl.innerText;
          }

          return color ? color.trim().toLowerCase() : '';
        }

        function applyBroadcastFilter() {
          const activeColor = getSelectedColor();
          if (!activeColor) return;

          // আপনার ইন্সপেক্ট এলিমেন্ট অনুযায়ী এক্সাক্ট ক্লাস
          const thumbs = document.querySelectorAll('.product__thumbs .product__thumb');

          thumbs.forEach(function(thumb) {
            const img = thumb.querySelector('img');
            if (img) {
              const altText = img.getAttribute('alt') ? img.getAttribute('alt').trim().toLowerCase() : '';

              if (altText !== '') {
                // অল্ট টেক্সট যদি সিলেক্টেড কালারের সাথে মিলে যায়
                if (altText === activeColor || altText.includes(activeColor)) {
                  thumb.classList.remove('v-strict-hide');
                } else {
                  // যদি শুধু অন্য কালারের ভ্যারিয়েন্ট ইমেজ হয়
                  if (altText === 'white' || altText === 'natural' || altText.includes('white') || altText.includes('natural')) {
                    thumb.classList.add('v-strict-hide');
                  }
                }
              }
            }
          });
        }

        // ইউজার কালার চেঞ্জ করলে বা ক্লিক করলে রান হবে
        document.addEventListener('click', function(e) {
          if (e.target.closest('input[type="radio"], label, .swatch-element, .ColorSwatch')) {
            setTimeout(applyBroadcastFilter, 30);
            setTimeout(applyBroadcastFilter, 150);
          }
        });

        document.addEventListener('change', function() {
          setTimeout(applyBroadcastFilter, 50);
        });

        // ইনিশিয়াল লোডের ফাঁকা জায়গা চিরতরে লক করার জন্য মাল্টি-টাইমিং এক্সিকিউশন
        setTimeout(applyBroadcastFilter, 50);
        setTimeout(applyBroadcastFilter, 300);
        setTimeout(applyBroadcastFilter, 800);
        window.addEventListener('load', applyBroadcastFilter);
      })();
      </script>

    <script>
      document.addEventListener('DOMContentLoaded', function () {
        console.log('Script Loaded and Window Fully Loaded');

        // Function to initialize custom select elements
        function initializeCustomSelects() {
          const customSelectElements = document.querySelectorAll('.custom-select');
          console.log('Number of .custom-select elements found:', customSelectElements.length);

          customSelectElements.forEach((customSelect, index) => {
            if (customSelect.dataset.initialized) {
              return; // Prevent re-initialization
            }
            customSelect.dataset.initialized = 'true';

            console.log(`Initializing custom-select #${index + 1}`);

            const trigger = customSelect.querySelector('.custom-select-trigger');
            const options = customSelect.querySelectorAll('.custom-option');
            const productid = trigger.getAttribute('product-id');
            const addToCartButton = document.getElementById('add-to-cart-button-' + productid);
            let selectedVariantId = null;

            // Check for required elements
            if (!trigger || options.length === 0) {
              console.error('Required elements not found within custom-select:', customSelect);
              return;
            }

            // Set ARIA attributes for accessibility
            customSelect.setAttribute('role', 'listbox');
            trigger.setAttribute('aria-expanded', 'false');
            trigger.setAttribute('tabindex', '0'); // Make trigger focusable

            options.forEach((option) => {
              option.setAttribute('role', 'option');
              option.setAttribute('tabindex', '-1'); // Make options focusable
              if (option.classList.contains('disabled')) {
                option.setAttribute('aria-disabled', 'true');
              }
            });

            // Toggle dropdown on trigger click
            trigger.addEventListener('click', (event) => {
              event.stopPropagation();
              const isOpen = customSelect.classList.toggle('open');
              trigger.setAttribute('aria-expanded', isOpen);
              console.log(`Dropdown toggled: ${isOpen ? 'Opened' : 'Closed'}`);

              if (isOpen) {
                adjustDropdownPosition(customSelect, trigger);
              }
            });

            // Close dropdown when pressing Escape key
            trigger.addEventListener('keydown', (event) => {
              if (event.key === 'Escape') {
                customSelect.classList.remove('open');
                trigger.setAttribute('aria-expanded', 'false');
                console.log('Dropdown closed with Escape key');
              }
            });

            // Select an option
            options.forEach((option) => {
              option.addEventListener('click', (event) => {
                event.stopPropagation();
                if (!option.classList.contains('disabled')) {
                  selectedVariantId = option.getAttribute('data-value');
                  trigger.textContent = option.textContent;
                  trigger.setAttribute('data-value', selectedVariantId);
                  customSelect.classList.remove('open');
                  trigger.setAttribute('aria-expanded', 'false');
                  console.log('Option selected:', option.textContent, 'Value:', selectedVariantId);

                  // Enable add-to-cart button if variant selected
                  if (addToCartButton) {
                    addToCartButton.removeAttribute('disabled');
                  }
                }
              });
            });

            // Close dropdown if clicking outside
            document.addEventListener('click', (event) => {
              if (!customSelect.contains(event.target)) {
                if (customSelect.classList.contains('open')) {
                  console.log('Dropdown closed due to outside click:', customSelect);
                }
                customSelect.classList.remove('open');
                trigger.setAttribute('aria-expanded', 'false');
              }
            });

            // Close dropdown when mouse leaves the dropdown area
            customSelect.addEventListener('mouseleave', () => {
              customSelect.classList.remove('open');
              trigger.setAttribute('aria-expanded', 'false');
              console.log('Dropdown closed on mouse leave');
            });

            // Handle Add to Cart button click using fetch
            if (addToCartButton) {
              addToCartButton.addEventListener('click', function (event) {
                event.preventDefault(); // Prevent default form submission

                if (!selectedVariantId) {
                  console.error('No variant selected, Add to Cart action prevented');
                  return;
                }

                // Provide feedback that the add-to-cart process is starting
                addToCartButton.textContent = 'Adding...';
                addToCartButton.setAttribute('disabled', 'disabled');

                // Prepare form data with necessary fields
                const formData = new URLSearchParams();
                formData.append('id', selectedVariantId);
                formData.append('quantity', 1); // Set default quantity to 1

                console.log('Submitting Add to Cart request with:', {
                  id: selectedVariantId,
                  quantity: 1,
                });

                // Send the POST request using fetch
                fetch('/cart/add.js', {
                  // Ensure endpoint is correct and ends with .js for JSON response
                  method: 'POST',
                  body: formData,
                  headers: {
                    'Content-Type': 'application/x-www-form-urlencoded', // Proper content type for form data
                    Accept: 'application/json', // Important to request JSON response
                  },
                })
                  .then((response) => {
                    console.log('Response status:', response.status);
                    if (!response.ok) {
                      // Log the status and response text for detailed error inspection
                      return response.text().then((text) => {
                        throw new Error(`HTTP error! status: ${response.status}, response: ${text}`);
                      });
                    }
                    return response.json(); // Parse the JSON response
                  })
                  .then((data) => {
                    console.log('Add to Cart successful:', data);
                    // Redirect to the cart page after successful addition
                    window.location.href = '/cart';
                  })
                  .catch((error) => {
                    console.error('Error adding to cart:', error);
                    addToCartButton.textContent = 'Error, try again';
                  })
                  .finally(() => {
                    // Re-enable button after response or error
                    addToCartButton.removeAttribute('disabled');
                  });
              });
            }
          });
        }

        // Adjust dropdown position based on available space
        function adjustDropdownPosition(customSelect, trigger) {
          const rect = trigger.getBoundingClientRect();
          const viewportHeight = window.innerHeight;
          const dropdownHeight = customSelect.querySelector('.custom-options').offsetHeight;

          const spaceBelow = viewportHeight - rect.bottom;
          const spaceAbove = rect.top;

          if (spaceBelow < dropdownHeight && spaceAbove > dropdownHeight) {
            // Not enough space below, and enough space above: Open upwards
            customSelect.classList.add('open-up');
          } else {
            // Default behavior: Open downwards
            customSelect.classList.remove('open-up');
          }
        }

        // Initialize custom selects if already present
        initializeCustomSelects();

        // Use MutationObserver to watch for dynamically added custom-select elements
        const observer = new MutationObserver((mutations) => {
          mutations.forEach((mutation) => {
            mutation.addedNodes.forEach((node) => {
              if (node.nodeType === 1 && node.matches('.custom-select')) {
                console.log('New .custom-select element detected:', node);
                initializeCustomSelects(); // Re-initialize when new elements are detected
              } else if (node.nodeType === 1) {
                const newSelects = node.querySelectorAll('.custom-select');
                if (newSelects.length > 0) {
                  console.log(`Detected ${newSelects.length} new .custom-select elements inside added node.`);
                  initializeCustomSelects();
                }
              }
            });
          });
        });

        // Start observing the body for added nodes
        observer.observe(document.body, {
          childList: true,
          subtree: true,
        });
      });
    </script>

